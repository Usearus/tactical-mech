[gd_resource type="Resource" script_class="UpgradeCatalog" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/cards/upgrade_catalog.gd" id="1_cat"]
[ext_resource type="Script" path="res://scripts/cards/upgrade_offer.gd" id="2_offer"]
[ext_resource type="Script" path="res://scripts/cards/card_data.gd" id="3_card"]

[sub_resource type="Resource" id="ram"]
script = ExtResource("3_card")
id = "bastion_ram"
display_name = "Ram"
description = "Step 2, then a heavy strike."
card_type = "Attack"
damage = 7
reach = 1
movement = 2
move_timing = "Before"
target_type = "enemy"

[sub_resource type="Resource" id="fortify"]
