[gd_resource type="Resource" script_class="UpgradeCatalog" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/cards/upgrade_catalog.gd" id="1_cat"]
[ext_resource type="Script" path="res://scripts/cards/upgrade_offer.gd" id="2_offer"]
[ext_resource type="Script" path="res://scripts/cards/card_data.gd" id="3_card"]

[sub_resource type="Resource" id="streak"]
script = ExtResource("3_card")
id = "comet_streak"
display_name = "Streak"
description = "Step, then a free shot."
cost_kind = "Free"
card_type = "Attack"
damage = 4
reach = 2
movement = 1
move_timing = "Before"
target_type = "enemy"

[sub_resource type="Resource" id="dash"]
script = ExtResource("3_card")
id = "comet_afterimage"
display_name = "Afterimage"
description = "Guard, catch the next hit, then step 3."
card_type = "Defense"
defense_kind = "Guard"
block = 4
reach = 0
movement = 3
target_type = "self"
intercept = true

[sub_resource type="Resource" id="o1"]
script = ExtResource("2_offer")
id = "comet_skim_damage"
kind = "Modify"
rarity = 1
mech_id = "comet"
card_family = "comet_skim"
damage_add = 2
blurb = "Upgraded: +2 damage."

[sub_resource type="Resource" id="o2"]
script = ExtResource("2_offer")
id = "comet_skim_free"
kind = "Modify"
rarity = 3
mech_id = "comet"
card_family = "comet_skim"
make_free = true
blurb = "Upgraded: costs no action."

[sub_resource type="Resource" id="o3"]
script = ExtResource("2_offer")
id = "comet_slip_move"
kind = "Modify"
rarity = 1
mech_id = "comet"
card_family = "comet_slip"
movement_add = 1
blurb = "Upgraded: +1 movement."

[sub_resource type="Resource" id="o4"]
script = ExtResource("2_offer")
id = "comet_veil_free"
kind = "Modify"
rarity = 2
mech_id = "comet"
card_family = "comet_veil"
make_free = true
blurb = "Upgraded: costs no action."

[sub_resource type="Resource" id="o5"]
script = ExtResource("2_offer")
id = "comet_grant_streak"
kind = "Grant"
rarity = 2
mech_id = "comet"
card = SubResource("streak")

[sub_resource type="Resource" id="o6"]
script = ExtResource("2_offer")
id = "comet_grant_dash"
kind = "Grant"
rarity = 1
mech_id = "comet"
card = SubResource("dash")

[resource]
script = ExtResource("1_cat")
offers = Array[ExtResource("2_offer")]([SubResource("o1"), SubResource("o2"), SubResource("o3"), SubResource("o4"), SubResource("o5"), SubResource("o6")])
