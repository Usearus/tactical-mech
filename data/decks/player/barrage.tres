[gd_resource type="Resource" script_class="MechDeck" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/cards/mech_deck.gd" id="1_deck"]
[ext_resource type="Script" path="res://scripts/cards/card_data.gd" id="2_card"]

[sub_resource type="Resource" id="c1"]
