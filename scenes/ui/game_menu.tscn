size_flags_horizontal = 3

[node name="Loadout" type="RichTextLabel" parent="Root/HowTo/Margin/Column/Split/Directions/Pages"]
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_effects = Array[RichTextEffect]([SubResource("RichTextEffect_gold")])
theme_override_colors/default_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/normal_font_size = 36
text = "Choose mechs before starting a mission. The squad [gold]Overdrive[/gold] gauge holds 12 charge. Once it is full, [gold]Overdrive[/gold] can be activated in battle.

[gold]HP[/gold] = Hit points at start of mission
[gold]ATK[/gold] = Attack power from deck
[gold]RNG[/gold] = Attack range from deck. Also initiate attack distance.
[gold]MOV[/gold] = Movement range on map
[gold]SPD[/gold] = Higher speed moves first on map"
autowrap_mode = 3

[node name="MapTimeline" type="RichTextLabel" parent="Root/HowTo/Margin/Column/Split/Directions/Pages"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_effects = Array[RichTextEffect]([SubResource("RichTextEffect_gold")])
theme_override_colors/default_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/normal_font_size = 36
text = "The timeline lists every living mech. [gold]Speed[/gold] ([gold]SPD[/gold]) sets the order, and higher [gold]Speed[/gold] moves first. On your turn, move, then end the turn or attack an enemy within your attack range ([gold]ATR[/gold]). Most mechs must stand next to the target."
autowrap_mode = 3

[node name="Fight" type="RichTextLabel" parent="Root/HowTo/Margin/Column/Split/Directions/Pages"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_effects = Array[RichTextEffect]([SubResource("RichTextEffect_gold")])
theme_override_colors/default_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/normal_font_size = 36
text = "Attack an enemy within your [gold]ATR[/gold] to start a fight. Mechs standing in the highlighted area join, yours and theirs. Going in alone is a disadvantage, so keep the squad nearby when you attack or are attacked."
autowrap_mode = 3

[node name="Cards" type="RichTextLabel" parent="Root/HowTo/Margin/Column/Split/Directions/Pages"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_effects = Array[RichTextEffect]([SubResource("RichTextEffect_gold")])
theme_override_colors/default_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/normal_font_size = 36
text = "Each mech brings its own deck. More mechs in the fight means more cards. Play a card, then choose its target. Attacks deal damage within their range. Move cards step that mech. You can [gold]discard[/gold] a card instead of playing it. A battle lasts two rounds, or ends sooner if one side is wiped out."
autowrap_mode = 3

[node name="Defense" type="RichTextLabel" parent="Root/HowTo/Margin/Column/Split/Directions/Pages"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_effects = Array[RichTextEffect]([SubResource("RichTextEffect_gold")])
theme_override_colors/default_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/normal_font_size = 36
text = "[gold]Guard[/gold] absorbs hits during the battle, then drops when you return to the map. [gold]Barrier[/gold] absorbs hits after [gold]Guard[/gold], and whatever is left stays on the map. A [gold]Dodge[/gold] card stays in hand and negates one incoming attack."
autowrap_mode = 3

[node name="Timers" type="RichTextLabel" parent="Root/HowTo/Margin/Column/Split/Directions/Pages"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_effects = Array[RichTextEffect]([SubResource("RichTextEffect_gold")])
theme_override_colors/default_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/normal_font_size = 36
text = "Each enemy shows how many cards are left before it acts. Playing a card, or ending the round, counts every timer down. At zero, that enemy takes a turn, then its count starts over. [gold]Discarding[/gold] a card does not count the timers down."
autowrap_mode = 3

[node name="OverdriveBar" type="RichTextLabel" parent="Root/HowTo/Margin/Column/Split/Directions/Pages"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_effects = Array[RichTextEffect]([SubResource("RichTextEffect_gold")])
theme_override_colors/default_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/normal_font_size = 36
text = "The [gold]Overdrive[/gold] gauge belongs to the whole squad and holds 12 charge. When the bar is full, [gold]Overdrive[/gold] can be activated. Charge you have not used carries into the next fight."
autowrap_mode = 3

[node name="GainingOverdrive" type="RichTextLabel" parent="Root/HowTo/Margin/Column/Split/Directions/Pages"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_effects = Array[RichTextEffect]([SubResource("RichTextEffect_gold")])
theme_override_colors/default_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/normal_font_size = 36
text = "Discarding a card in battle adds 1 [gold]charge[/gold]. Throwing a hand away for a new one on round 1 adds 1 [gold]charge[/gold] per card. Cards still in hand when the battle ends add 1 [gold]charge[/gold] each."
autowrap_mode = 3

[node name="UsingOverdrive" type="RichTextLabel" parent="Root/HowTo/Margin/Column/Split/Directions/Pages"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_effects = Array[RichTextEffect]([SubResource("RichTextEffect_gold")])
theme_override_colors/default_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/normal_font_size = 36
text = "When the gauge is full, press [gold]Activate Overdrive[/gold] in battle. For the rest of that fight, attacks hit harder, guards block more, and each mech's [gold]Overdrive[/gold] card can enter the hand. The gauge is spent when that fight ends."
autowrap_mode = 3

