[node name="Body" type="Label" parent="Root/HowTo/Column/Pages/Loadout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/font_size = 36
text = "Choose mechs before starting a mission. Mechs have individual stats to look out for, including their Overdrive (OVD) value, which determines how many actions it will take to activate the Overdrive mechanic and create bonus' for your team during battle.

HP = Hit points at start of mission
ATK = Attack power from deck
RNG = Attack range from deck. Also initiate attack distance.
MOV = Movement range on map
SPD = Higher speed moves first on map
OVD = Additional actions needed to activate Overdrive"
autowrap_mode = 3

