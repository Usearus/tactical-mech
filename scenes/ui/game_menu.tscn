theme_override_font_sizes/font_size = 36
text = "Moving on the map and discarding cards in battle fills the squad's Overdrive gauge. When the Overdrive gauge is full, press Activate Overdrive in battle to enable Overdrive for the remainder of the battle. Attacks hit harder, guards block more, and each mech's overdrive card can enter the hand. The gauge is spent when the fight ends."
