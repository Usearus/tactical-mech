[node name="Column" type="VBoxContainer" parent="Root/MenuPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MissionLog" parent="Root/MenuPanel/Column" instance=ExtResource("10_btn")]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 64)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 32
text = "Mission Log"

[node name="LegendButton" parent="Root/MenuPanel/Column" instance=ExtResource("10_btn")]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 64)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 32
text = "Legend"

[node name="QuitButton" parent="Root/MenuPanel/Column" instance=ExtResource("10_btn")]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 64)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 32
text = "Quit demo"
