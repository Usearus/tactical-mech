theme_override_styles/panel = SubResource("StyleBoxFlat_menu")

[node name="Column" type="VBoxContainer" parent="Root/MenuPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MissionLog" type="Button" parent="Root/MenuPanel/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 64)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 32
text = "Mission Log"

[node name="LegendButton" type="Button" parent="Root/MenuPanel/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 64)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 32
text = "Legend"

[node name="QuitButton" type="Button" parent="Root/MenuPanel/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 64)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 32
text = "Quit demo"
